rules_version = '2';

// Multi-tenant real + super administrador global.
// Principios:
// 1. Nadie lee ni escribe fuera de su organizationId.
// 2. En /users no hay writes desde el cliente — role, organizationId e isTestUser
//    solo los escribe el servidor (Admin SDK, que no pasa por estas reglas).
// 3. En documentos comerciales, organizationId, isTestData y salespersonId no
//    pueden cambiarse en un update.
// 4. El reviewer opera como administrador PERO únicamente dentro de su propia
//    organización de Testing — el aislamiento por organizationId ya impide que
//    vea o contamine datos reales.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole() { return me().role; }
    function myOrgId() { return me().organizationId; }

    // SUPER ADMINISTRADOR GLOBAL.
    // La única fuente de verdad es /systemAdmins/{uid}, colección que NADIE
    // puede escribir desde el cliente (write: false más abajo): solo la crea el
    // Admin SDK desde el servidor. Cambiar el correo, el rol en /users o
    // cualquier campo desde el navegador NO concede este privilegio.
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/systemAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.active != false;
    }

    function isOrgManager() {
      return isSuperAdmin() || myRole() == 'distributor' || myRole() == 'reviewer';
    }

    function creatingInMyOrg() {
      return request.resource.data.organizationId == myOrgId()
        && request.resource.data.isTestData == me().isTestUser
        && request.resource.data.createdBy == request.auth.uid;
    }
    // El super admin accede a cualquier workspace para soporte/administración;
    // el resto, únicamente a su propia organización.
    function resourceInMyOrg() { return isSuperAdmin() || resource.data.organizationId == myOrgId(); }
    function ownsResource() { return resource.data.salespersonId == request.auth.uid; }
    function protectedFieldsUnchanged() {
      return request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.isTestData == resource.data.isTestData;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;   // role/organizationId/active los escribe solo el servidor
    }

    // Registro de super administradores. Cada quien puede LEER solo su propio
    // documento (para que la app sepa si mostrar el panel). Nadie escribe:
    // el bootstrap y las altas ocurren en el servidor con el Admin SDK.
    match /systemAdmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Workspaces (colección histórica `organizations`).
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSuperAdmin() || myOrgId() == orgId);
      allow write: if false;   // crear/activar workspaces: solo /api/admin/workspaces
    }

    // Membresías (colección histórica `organizationMembers`). Cada usuario ve
    // las suyas; un manager, las de su propio workspace; el super admin, todas.
    // Nunca se escriben desde el cliente: un distribuidor no puede alterar
    // membresías ni concederse otro rol.
    match /organizationMembers/{memberId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.uid == request.auth.uid
        || (isOrgManager() && resource.data.organizationId == myOrgId())
      );
      allow write: if false;
    }

    // customers usa assignedSalespersonId como campo de ownership.
    match /customers/{id} {
      allow create: if isSignedIn() && creatingInMyOrg()
        && request.resource.data.assignedSalespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg()
        && (isOrgManager() || resource.data.assignedSalespersonId == request.auth.uid);
      allow update: if isSignedIn() && resourceInMyOrg() && protectedFieldsUnchanged()
        && request.resource.data.assignedSalespersonId == resource.data.assignedSalespersonId
        && (isOrgManager() || resource.data.assignedSalespersonId == request.auth.uid);
      allow delete: if false;
    }

    // El mismo patrón para el resto de colecciones comerciales (ownership: salespersonId).
    match /visits/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update: if isSignedIn() && resourceInMyOrg() && protectedFieldsUnchanged()
        && request.resource.data.salespersonId == resource.data.salespersonId
        && (isOrgManager() || ownsResource());
      allow delete: if false;
    }

    match /surveyResponses/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update, delete: if false;
    }

    match /aiProfiles/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update, delete: if false;
    }

    match /visitResults/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update, delete: if false;
    }

    match /purchases/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update, delete: if false;
    }

    match /followups/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update: if isSignedIn() && resourceInMyOrg() && protectedFieldsUnchanged()
        && request.resource.data.salespersonId == resource.data.salespersonId
        && (isOrgManager() || ownsResource());
      allow delete: if false;
    }

    match /customerInteractions/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update, delete: if false;
    }

    match /notes/{id} {
      allow create: if isSignedIn() && creatingInMyOrg() && request.resource.data.salespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg() && (isOrgManager() || ownsResource());
      allow update, delete: if false;
    }

    // Fase A/D — líneas de compra ligadas al catálogo. No llevan salespersonId;
    // el aislamiento es por organización. Append-only (igual que purchases).
    match /purchaseItems/{id} {
      allow create: if isSignedIn() && creatingInMyOrg();
      allow read: if isSignedIn() && resourceInMyOrg();
      allow update, delete: if false;
    }

    // Catálogo de productos: COMPARTIDO por toda la organización (sin
    // isTestData ni ownership individual). Cualquier miembro de la org lo lee;
    // la siembra/actualización del catálogo la hace el cliente al iniciar
    // sesión (seedCatalogIfEmpty), así que create/update se permiten dentro de
    // la organización.
    // BORRADO: SOLO super administrador. El catálogo es material compartido por
    // todo el workspace (179 productos): ni un vendedor ni un distribuidor
    // deben poder vaciarlo desde el cliente. La lectura no cambia.
    match /products/{id} {
      allow read: if isSignedIn() && resourceInMyOrg();
      allow create: if isSignedIn() && request.resource.data.organizationId == myOrgId();
      allow update: if isSignedIn() && resourceInMyOrg()
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isSuperAdmin();
    }

    // Fase B/D — servicios postventa. Ownership por assignedSalespersonId.
    // Lo completa/reasigna el dueño o un manager; nunca se borra desde cliente.
    match /postSaleServices/{id} {
      allow create: if isSignedIn() && creatingInMyOrg()
        && request.resource.data.assignedSalespersonId == request.auth.uid;
      allow read: if isSignedIn() && resourceInMyOrg()
        && (isOrgManager() || resource.data.assignedSalespersonId == request.auth.uid);
      allow update: if isSignedIn() && resourceInMyOrg() && protectedFieldsUnchanged()
        && (isOrgManager() || resource.data.assignedSalespersonId == request.auth.uid);
      allow delete: if false;
    }

    // Fase C/D — contenido oficial de producto. Cualquiera de la org crea/edita
    // borradores; SOLO un manager puede aprobar/rechazar (cambiar el status)
    // o BORRAR (el contenido aprobado es material oficial compartido: antes
    // cualquier vendedor podía eliminarlo).
    match /productContent/{id} {
      allow create: if isSignedIn() && creatingInMyOrg();
      allow read: if isSignedIn() && resourceInMyOrg();
      allow update: if isSignedIn() && resourceInMyOrg() && protectedFieldsUnchanged()
        && (isOrgManager() || request.resource.data.status == resource.data.status);
      // Borrar contenido oficial: dueño del workspace (distributor/reviewer) o
      // super admin. Un vendedor nunca.
      allow delete: if isSignedIn() && resourceInMyOrg() && isOrgManager();
    }

    // Fase E — Royal Copilot.
    // Conocimiento OFICIAL de garantías: colección GLOBAL (no por organización),
    // de solo lectura para cualquier usuario autenticado. La escribe únicamente
    // el servidor (endpoint admin con Admin SDK, que no pasa por estas reglas).
    match /warrantyKnowledge/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Fichas oficiales de producto (base de conocimiento del Copilot). También
    // es contenido maestro GLOBAL: cualquier usuario autenticado puede leerlo,
    // nadie puede escribirlo desde el cliente. Las escribe únicamente el
    // endpoint /api/admin/seed-product-knowledge con el Admin SDK, que exige
    // super administrador.
    match /productKnowledge/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Conversaciones del Copilot. Las escribe SOLO el servidor (Admin SDK); el
    // cliente únicamente puede LEER las suyas (uid propio). Los mensajes viven
    // en una subcolección y también guardan uid para poder filtrarlos aquí.
    match /copilotConversations/{convId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Uso agregado del Copilot (tokens/intención) para monitoreo de costos.
    // Solo lectura del propio usuario; lo escribe el servidor.
    match /copilotUsage/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
